<%- include('../partials/head') %>
<main class="ks-main"><div class="ks-container">
  <div class="ks-page-head"><div><h1 data-i18n="nav.profile">My Profile</h1><p data-i18n="prof.sub">Keep your business details up to date.</p></div></div>
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="ks-card ks-card-pad text-center">
        <div class="ks-avatar mx-auto mb-3" style="width:84px;height:84px;font-size:2rem"><%= buyer.full_name.charAt(0).toUpperCase() %></div>
        <h4 class="fw-bold mb-0"><%= buyer.full_name %></h4><div class="text-muted"><%= buyer.b_name %></div>
        <span class="ks-badge st-approved mt-2"><i class="bi bi-shield-check"></i> <%= buyer.b_type %></span>
        <hr><div class="text-start small d-grid gap-2">
          <div><i class="bi bi-envelope text-success me-2"></i><%= buyer.email %></div>
          <div><i class="bi bi-telephone text-success me-2"></i><%= buyer.mobile %></div>
          <div><i class="bi bi-calendar3 text-success me-2"></i><span data-i18n="prof.member">Member since</span> <%= fdate(buyer.created_at) %></div>
        </div><hr>
        <div class="row text-center g-2"><div class="col-6"><div class="fs-4 fw-bold" data-stat="totalOrders"><%= stats.totalOrders %></div><small class="text-muted" data-i18n="stat.total_orders">Total Orders</small></div><div class="col-6"><div class="fs-4 fw-bold" data-stat="totalEnquiries"><%= stats.totalEnquiries %></div><small class="text-muted" data-i18n="stat.enquiries">Enquiries</small></div></div>
      </div>
    </div>
    <div class="col-lg-8">
      <form method="POST" action="/buyer/profile" class="ks-card ks-card-pad mb-4">
        <h5 class="fw-bold mb-3" data-i18n="prof.details">Personal & business details</h5>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" data-i18n="prof.name">Full name</label><input class="form-control" name="full_name" value="<%= buyer.full_name %>" required></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.mobile">Mobile</label><input class="form-control" name="mobile" value="<%= buyer.mobile %>" required pattern="[0-9+\-\s]{10,15}"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.email">Email (cannot be changed)</label><input class="form-control" value="<%= buyer.email %>" disabled></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.type">Buyer type</label>
            <select class="form-select" name="b_type"><% ['Individual','Retailer','Wholesaler','Restaurant / Hotel','Processor','Exporter'].forEach(t => { %><option <%= buyer.b_type === t ? 'selected' : '' %>><%= t %></option><% }) %><% if (!['Individual','Retailer','Wholesaler','Restaurant / Hotel','Processor','Exporter'].includes(buyer.b_type)) { %><option selected><%= buyer.b_type %></option><% } %></select></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.business">Business name</label><input class="form-control" name="b_name" value="<%= buyer.b_name %>"></div>
          <div class="col-md-6"><label class="form-label">GST <small class="text-muted">(optional)</small></label><input class="form-control" name="gst_number" maxlength="15" value="<%= buyer.gst_number || '' %>" style="text-transform:uppercase"></div>
          <div class="col-12"><label class="form-label" data-i18n="prof.address">Address</label><input class="form-control" name="b_address" value="<%= buyer.b_address %>"></div>
          <div class="col-md-4"><label class="form-label" data-i18n="prof.city">City</label><input class="form-control" name="city" value="<%= buyer.city || '' %>"></div>
          <div class="col-md-4"><label class="form-label" data-i18n="prof.state">State</label><input class="form-control" name="state" value="<%= buyer.state || '' %>"></div>
          <div class="col-md-4"><label class="form-label" data-i18n="prof.pin">PIN code</label><input class="form-control" name="pincode" maxlength="6" value="<%= buyer.pincode || '' %>"></div>
        </div>
        <button class="btn btn-success mt-3" type="submit" data-loading="Saving…"><i class="bi bi-check2-circle me-1"></i><span data-i18n="btn.save">Save changes</span></button>
      </form>
      <form method="POST" action="/buyer/profile/password" class="ks-card ks-card-pad" id="security">
        <h5 class="fw-bold mb-3" data-i18n="prof.password">Change password</h5>
        <div class="row g-3">
          <div class="col-md-4"><input type="password" class="form-control" name="current_password" placeholder="Current password" data-i18n-ph="prof.cur" required></div>
          <div class="col-md-4"><input type="password" class="form-control" name="new_password" minlength="8" placeholder="New password" data-i18n-ph="prof.new" required></div>
          <div class="col-md-4"><input type="password" class="form-control" name="confirm_password" minlength="8" placeholder="Confirm new password" data-i18n-ph="prof.confirm" required></div>
        </div>
        <button class="btn btn-outline-success mt-3" type="submit"><i class="bi bi-key me-1"></i><span data-i18n="btn.update_password">Update password</span></button>
      </form>
    </div>
  </div>
</div></main>
<%- include('../partials/footer') %>
