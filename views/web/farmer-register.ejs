<%- include('header.ejs') %>

<!-- Authentication Stylesheet -->
<link rel="stylesheet" href="/web/css/auth.css">

  <!-- Auth Main Content -->
  <main class="auth-page-wrapper">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-11 col-lg-12">
          <div class="auth-card">
            <div class="row g-0">
              
              <!-- Left Visual / Farmer Benefit Showcase -->
              <div class="col-lg-4 d-none d-lg-flex auth-side-banner">
                <div class="auth-side-content">
                  <span class="auth-feature-badge">
                    <i class="fa-solid fa-seedling text-warning"></i> Certified Farmer Portal
                  </span>
                  <h2 class="h3 fw-bold mb-3 text-white">Sell Produce Directly to Verified Buyers</h2>
                  <p class="text-white-50 mb-4 small leading-relaxed">
                    Eliminate middlemen, receive guaranteed fair market rates, and get transparent direct bank payments for your agricultural harvest.
                  </p>

                  <div class="feature-list">
                    <div class="feature-list-item">
                      <div class="feature-list-icon">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                      </div>
                      <div>
                        <h6 class="mb-0 fw-semibold text-white small">0% Broker Commission</h6>
                        <small class="text-white-50">100% of the negotiated crop value reaches your bank account directly.</small>
                      </div>
                    </div>

                    <div class="feature-list-item">
                      <div class="feature-list-icon">
                        <i class="fa-solid fa-tractor"></i>
                      </div>
                      <div>
                        <h6 class="mb-0 fw-semibold text-white small">Doorstep Farm-Gate Pickup</h6>
                        <small class="text-white-50">Verified logistics partners collect produce straight from your farm field.</small>
                      </div>
                    </div>

                    <div class="feature-list-item">
                      <div class="feature-list-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                      </div>
                      <div>
                        <h6 class="mb-0 fw-semibold text-white small">Secure Trade Protection</h6>
                        <small class="text-white-50">Payment guarantee and prompt dispute resolution for every batch.</small>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="auth-side-footer text-white-50 pt-4 border-top border-white border-opacity-25 small">
                  <i class="fa-solid fa-phone me-1 text-warning"></i> Kisan Helpline: <strong>1800-266-3276</strong> (Toll-Free)
                </div>
              </div>

              <!-- Right Form Section -->
              <div class="col-lg-8">
                <div class="auth-form-container">
                  
                  <!-- Role switch indicator -->
                  <div class="role-switcher">
                    <a href="/farmer_register" class="role-switcher-btn active" aria-current="page">
                      <i class="fa-solid fa-tractor bi bi-person-badge"></i> Farmer Account
                    </a>
                    <a href="/buyer_register" class="role-switcher-btn">
                      <i class="fa-solid fa-cart-shopping bi bi-shop"></i> Buyer / Trader Account
                    </a>
                  </div>

                  <div class="mb-4">
                    <h1 class="auth-title">Create Farmer Account</h1>
                    <p class="auth-subtitle">Join thousands of Indian farmers growing profits directly on KisanSetu.</p>
                  </div>

                  <!-- Alert placeholder for submission response -->
                  <div id="authAlertPlaceholder"></div>

                  <form id="farmerRegisterForm" novalidate autocomplete="on" method="post" action="/farmer_register_save">
                    
                    <!-- Full Name & Mobile -->
                    <div class="row g-3 mb-3">
                      <div class="col-md-6">
                        <label for="farmerFullName" class="form-label">
                          Full Name <span class="required-star">*</span>
                        </label>
                        <div class="input-group">
                          <span class="input-group-text"><i class="fa-solid fa-user bi bi-person"></i></span>
                          <input 
                            type="text" 
                            class="form-control validate-name" 
                            id="full_name" 
                            name="full_name"
                            placeholder="e.g., Ramesh Kumar" 
                            required 
                            minlength="3"
                            maxlength="60"
                            autocomplete="name">
                          <div class="invalid-feedback">Please enter your full name (minimum 3 characters).</div>
                        </div>
                      </div>

                      <div class="col-md-6">
                        <label for="farmerMobile" class="form-label">
                          Mobile Number (India) <span class="required-star">*</span>
                        </label>
                        <div class="input-group">
                          <input 
                            type="tel" 
                            class="form-control validate-mobile" 
                            id="farmerMobile" 
                            name="mobile"
                            placeholder="98765 43210" 
                            required 
                            maxlength="13"
                            autocomplete="tel">
                          <div class="invalid-feedback">Enter a valid 10-digit Indian mobile number.</div>
                        </div>
                      </div>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                      <label for="farmerEmail" class="form-label">
                        Email Address <span class="required-star">*</span>
                      </label>
                      <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-envelope bi bi-envelope"></i></span>
                        <input 
                          type="email" 
                          class="form-control validate-email" 
                          id="farmerEmail" 
                          name="email"
                          placeholder="ramesh.farmer@example.com" 
                          required
                          autocomplete="email">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                      </div>
                    </div>

                    <!-- Farm Details: Farm Name & Farm Location -->
                    <div class="row g-3 mb-3">
                      <div class="col-md-6">
                        <label for="farmLocation" class="form-label">
                          Farm Location  (State) <span class="required-star">*</span>
                        </label>
                        <div class="input-group">
                          <span class="input-group-text"><i class="fa-solid fa-location-dot bi bi-geo-alt"></i></span>
                          <input 
                            type="text" 
                            class="form-control" 
                            id="state" 
                            name="state"
                            placeholder="e.g., Nashik, Maharashtra" 
                            required
                            data-err-msg="Farm location is required.">
                          <div class="invalid-feedback">Please specify your farm district and state.</div>
                        </div>
                      </div>

                      <div class="col-md-6">
                        <label for="farmLocation" class="form-label">
                          Farm Location  (District) <span class="required-star">*</span>
                        </label>
                        <div class="input-group">
                          <span class="input-group-text"><i class="fa-solid fa-location-dot bi bi-geo-alt"></i></span>
                          <input 
                            type="text" 
                            class="form-control" 
                            id="district" 
                            name="district"
                            placeholder="e.g., Nashik, Maharashtra" 
                            required
                            data-err-msg="Farm location is required.">
                          <div class="invalid-feedback">Please specify your farm district and state.</div>
                        </div>
                      </div>
                    </div>

                   

                    <!-- Password with Strength Meter -->
                    <div class="row g-3 mb-3">
                      <div class="col-md-6 password-field-group">
                        <label for="password" class="form-label">
                          Password <span class="required-star">*</span>
                        </label>
                        <div class="input-group">
                          <span class="input-group-text"><i class="fa-solid fa-lock bi bi-lock"></i></span>
                          <input 
                            type="password" 
                            class="form-control has-toggle validate-password-create password-meter-input" 
                            id="f_password" 
                            name="f_password"
                            placeholder="At least 8 characters" 
                            required
                            minlength="8"
                            maxlength="64"
                            autocomplete="new-password">
                          <button 
                            type="button" 
                            class="btn btn-password-toggle" 
                            tabindex="-1"
                            aria-label="Show password">
                            <i class="fa-solid fa-eye bi bi-eye"></i>
                          </button>
                          <div class="invalid-feedback">Password does not meet requirements.</div>
                        </div>

                       
                      </div>

                      
                    </div>

                    <!-- Terms & Conditions Checkbox -->
                    <div class="form-check mb-4">
                      <input class="form-check-input" type="checkbox" id="farmerTerms" required data-err-msg="You must accept the terms to create an account.">
                      <label class="form-check-label text-secondary small" for="farmerTerms">
                        I agree to KisanSetu's <a href="/terms" class="text-success text-decoration-underline fw-semibold">Farmer Code of Conduct</a>, <a href="/terms" class="text-success text-decoration-underline fw-semibold">Terms of Service</a>, and <a href="/privacy" class="text-success text-decoration-underline fw-semibold">Privacy Policy</a>.
                      </label>
                      <div class="invalid-feedback">You must accept the terms to register.</div>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid mb-3">
                      <button type="submit" class="btn btn-agri btn-lg shadow-sm">
                        <i class="bi bi-person-plus-fill me-1"></i> <span data-i18n="btn.create_account">Create Account</span>
                      </button>
                    </div>

                    <!-- Link to Login -->
                    <div class="text-center pt-2">
                      <p class="text-muted mb-0 small">
                        Already have an account? 
                        <a href="/login" class="fw-semibold text-success text-decoration-none">Sign In here</a>
                      </p>
                    </div>

                  </form>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('footer.ejs') %>

  <!-- Authentication Client-side Script -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/web/js/auth.js"></script>
