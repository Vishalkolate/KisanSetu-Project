<%- include('header.ejs') %>

<!-- Authentication Stylesheet -->
<link rel="stylesheet" href="/web/css/auth.css">

  <!-- Auth Main Content -->
  <main class="auth-page-wrapper">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-7 col-md-9">
          <div class="auth-card p-4 p-md-5">
            
            <!-- Header & Icon -->
            <div class="text-center mb-4">
              <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                <i class="fa-solid fa-shield-halved text-white"></i>
              </div>
              <h1 class="auth-title">Reset Your Password</h1>
              <p class="auth-subtitle mb-0">
                Enter your registered Email Address or Indian Mobile Number to receive password reset instructions.
              </p>
            </div>

            <!-- Global Alert Placeholder -->
            <div id="authAlertPlaceholder"></div>

            <!-- Step 1: Identifier Input Form -->
            <div id="forgotInputSection">
              <form id="forgotPasswordForm" novalidate autocomplete="on">
                
                <div class="mb-4">
                  <label for="resetIdentifier" class="form-label">
                    Registered Email or Mobile Number <span class="required-star">*</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-user-shield bi bi-person-lines-fill"></i></span>
                    <input 
                      type="text" 
                      class="form-control validate-email-or-mobile" 
                      id="resetIdentifier" 
                      name="resetIdentifier"
                      placeholder="e.g., kisan@example.com or 9876543210" 
                      required
                      autocomplete="username">
                    <div class="invalid-feedback">Please enter a valid email address or 10-digit Indian mobile number.</div>
                  </div>
                  <small class="text-muted d-block mt-2">
                    <i class="fa-solid fa-circle-info bi bi-info-circle me-1 text-success"></i>We will send a one-time OTP or secure password reset link to this contact.
                  </small>
                </div>

                <!-- Submit Button -->
                <div class="d-grid mb-3">
                  <button type="submit" class="btn btn-agri btn-lg shadow-sm">
                    <i class="fa-solid fa-paper-plane bi bi-send me-1"></i> Send Reset Link / OTP
                  </button>
                </div>

                <!-- Back to Login -->
                <div class="text-center pt-2">
                  <a href="/login" class="fw-semibold text-secondary text-decoration-none small">
                    <i class="fa-solid fa-arrow-left bi bi-arrow-left me-1"></i> Back to Login
                  </a>
                </div>

              </form>
            </div>

            <!-- Step 2: Simulated OTP Verification Section (Revealed upon form submission) -->
            <div id="otpVerificationSection" style="display: none;">
              <div id="otpAlertPlaceholder"></div>
              
              <div class="p-4 bg-light rounded-4 border mb-4">
                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                  <i class="fa-solid fa-shield-check bi bi-shield-check text-success"></i>
                  <span>Enter Verification OTP</span>
                </h6>
                <p class="small text-muted mb-3">Please enter the 4-digit verification code sent to your registered contact.</p>
                
                <div class="mb-3">
                  <label for="otpInput" class="form-label">4-Digit Security Code <span class="required-star">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-key bi bi-key"></i></span>
                    <input 
                      type="text" 
                      class="form-control otp-digit-box text-center" 
                      id="otpInput" 
                      maxlength="6" 
                      placeholder="• • • •">
                  </div>
                </div>

                <div class="d-grid">
                  <button type="button" class="btn btn-agri" id="verifyOtpBtn">
                    <i class="fa-solid fa-circle-check bi bi-check2-circle me-1"></i> Verify OTP Code
                  </button>
                </div>
              </div>

              <div class="text-center">
                <small class="text-muted">
                  Didn't receive code? <a href="#" onclick="location.reload(); return false;" class="text-success fw-semibold text-decoration-none">Resend Code</a>
                </small>
              </div>
            </div>

            <!-- Step 3: Simulated New Password Form -->
            <div id="newPasswordSection" style="display: none;">
              <div id="newPassAlertPlaceholder"></div>

              <form id="resetPasswordForm" novalidate>
                <div class="mb-3">
                  <label for="newPassword" class="form-label">New Password <span class="required-star">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock bi bi-lock"></i></span>
                    <input 
                      type="password" 
                      class="form-control has-toggle" 
                      id="newPassword" 
                      placeholder="Minimum 8 characters"
                      required>
                    <button type="button" class="btn btn-password-toggle" tabindex="-1" aria-label="Show password">
                      <i class="fa-solid fa-eye bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="mb-4">
                  <label for="confirmNewPassword" class="form-label">Confirm New Password <span class="required-star">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-shield-halved bi bi-shield-lock"></i></span>
                    <input 
                      type="password" 
                      class="form-control has-toggle" 
                      id="confirmNewPassword" 
                      placeholder="Re-enter new password"
                      required>
                    <button type="button" class="btn btn-password-toggle" tabindex="-1" aria-label="Show password">
                      <i class="fa-solid fa-eye bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="d-grid mb-3">
                  <button type="submit" class="btn btn-agri btn-lg shadow-sm">
                    <i class="fa-solid fa-circle-check bi bi-check-circle me-1"></i> Update Password
                  </button>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('footer.ejs') %>

  <!-- Authentication Client-side Script -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/web/js/auth.js"></script>
