<%- include('header.ejs') %>

  <!-- ==================== HOME PAGE CONTENT ==================== -->
  <main class="home-page flex-grow-1">

    <!-- Hero Section with Search -->
    <section class="hero-section text-white py-5 position-relative">
      <div class="container py-lg-5">
        <div class="row align-items-center g-5">
          <div class="col-lg-7">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
              <i class="fa-solid fa-bolt me-1"></i> 0% Middlemen Commission
            </span>
            <h1 class="display-4 fw-bold lh-sm mb-3">
              Buy &amp; Sell Farm Produce Directly at Transparent Rates
            </h1>
            <p class="lead text-white-50 mb-4 pe-lg-4">
              A trusted digital agro-marketplace empowering local farmers to reach wholesale buyers, retail traders, and food processors directly.
            </p>

            <!-- Quick Stats in Hero -->
            <div class="d-flex flex-wrap gap-4 pt-2">
              <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-shield-halved text-warning fs-4"></i>
                <div>
                  <h6 class="mb-0 fw-bold">Admin Verified</h6>
                  <small class="text-white-50">Farmer KYC Verification</small>
                </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-comments text-warning fs-4"></i>
                <div>
                  <h6 class="mb-0 fw-bold">Direct Inquiry</h6>
                  <small class="text-white-50">Instant Quote Requests</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Hero Search Box / Filter Card -->
          <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 text-dark bg-white">
              <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-magnifying-glass text-success"></i>
                <span>Find Farm Produce</span>
              </h5>
              <form action="/products" method="GET">
                <!-- Crop Keyword -->
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-muted">Crop / Commodity</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-wheat-awn text-success"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-0" placeholder="e.g. Onion, Soybean, Wheat, Tomato">
                  </div>
                </div>

                <!-- Category -->
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-muted">Crop Category</label>
                  <select name="category" class="form-select bg-light border-0">
                    <option value="" selected>All Categories</option>
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                      <% categories.forEach(cat => { %>
                        <option value="<%= cat.category_name %>"><%= cat.category_name %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="Grains">Grains &amp; Cereals (धान्य)</option>
                      <option value="Pulses">Pulses &amp; Legumes (डाळी)</option>
                      <option value="Vegetables">Fresh Vegetables (भाजीपाला)</option>
                      <option value="Fruits">Fruits (फळे)</option>
                    <% } %>
                  </select>
                </div>

                <!-- District Location -->
                <div class="mb-4">
                  <label class="form-label small fw-semibold text-muted">District / Region</label>
                  <select name="district" class="form-select bg-light border-0">
                    <option value="" selected>All Maharashtra Districts</option>
                    <option value="pune">Pune</option>
                    <option value="nashik">Nashik</option>
                    <option value="nagpur">Nagpur</option>
                    <option value="chhatrapati-sambhajinagar">Chh. Sambhajinagar</option>
                    <option value="kolhapur">Kolhapur</option>
                    <option value="solapur">Solapur</option>
                    <option value="ahmednagar">Ahilyanagar (Ahmednagar)</option>
                  </select>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 rounded-pill fw-semibold shadow-sm">
                  <i class="fa-solid fa-filter me-1"></i> Search Available Stock
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Popular Categories Grid -->
    <section class="py-5">
      <div class="container py-3">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div>
            <h6 class="text-success fw-bold text-uppercase mb-1">Browse By Crop Type</h6>
            <h3 class="fw-bold mb-0">Popular Categories</h3>
          </div>
          <a href="/products" class="btn btn-sm btn-outline-success rounded-pill px-3">View All <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>

        <div class="row g-3">
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.slice(0, 6).forEach(cat => { %>
              <div class="col-6 col-md-4 col-lg-2">
                <a href="/products?category=<%= encodeURIComponent(cat.category_name) %>" class="text-decoration-none">
                  <div class="category-tile text-center p-3 rounded-4 bg-white shadow-sm border h-100">
                    <div class="category-icon mx-auto mb-2 text-success">
                      <% if (cat.category_name.toLowerCase().includes('veg')) { %>
                        <i class="fa-solid fa-carrot fs-3"></i>
                      <% } else if (cat.category_name.toLowerCase().includes('fruit')) { %>
                        <i class="fa-solid fa-apple-whole fs-3"></i>
                      <% } else if (cat.category_name.toLowerCase().includes('grain') || cat.category_name.toLowerCase().includes('cereal')) { %>
                        <i class="fa-solid fa-wheat-awn fs-3"></i>
                      <% } else if (cat.category_name.toLowerCase().includes('pulse') || cat.category_name.toLowerCase().includes('dal')) { %>
                        <i class="fa-solid fa-bowl-rice fs-3"></i>
                      <% } else { %>
                        <i class="fa-solid fa-seedling fs-3"></i>
                      <% } %>
                    </div>
                    <h6 class="fw-bold text-dark mb-1 text-truncate"><%= cat.category_name %></h6>
                    <small class="text-muted">Direct Stock</small>
                  </div>
                </a>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-6 col-md-4 col-lg-2">
              <a href="/products?category=Grains" class="text-decoration-none">
                <div class="category-tile text-center p-3 rounded-4 bg-white shadow-sm border h-100">
                  <div class="category-icon mx-auto mb-2 text-success"><i class="fa-solid fa-wheat-awn fs-3"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Grains</h6>
                  <small class="text-muted">धान्य व तृणधान्य</small>
                </div>
              </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
              <a href="/products?category=Vegetables" class="text-decoration-none">
                <div class="category-tile text-center p-3 rounded-4 bg-white shadow-sm border h-100">
                  <div class="category-icon mx-auto mb-2 text-success"><i class="fa-solid fa-carrot fs-3"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Vegetables</h6>
                  <small class="text-muted">ताजा भाजीपाला</small>
                </div>
              </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
              <a href="/products?category=Fruits" class="text-decoration-none">
                <div class="category-tile text-center p-3 rounded-4 bg-white shadow-sm border h-100">
                  <div class="category-icon mx-auto mb-2 text-success"><i class="fa-solid fa-apple-whole fs-3"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Fruits</h6>
                  <small class="text-muted">हंगामी फळे</small>
                </div>
              </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
              <a href="/products?category=Pulses" class="text-decoration-none">
                <div class="category-tile text-center p-3 rounded-4 bg-white shadow-sm border h-100">
                  <div class="category-icon mx-auto mb-2 text-success"><i class="fa-solid fa-bowl-rice fs-3"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Pulses</h6>
                  <small class="text-muted">कडधान्य व डाळी</small>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Featured Crops Section -->
    <section class="py-5 bg-white border-top border-bottom">
      <div class="container py-3">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div>
            <h6 class="text-success fw-bold text-uppercase mb-1">Direct From Farms</h6>
            <h3 class="fw-bold mb-0">Freshly Listed Crops</h3>
          </div>
          <a href="/products" class="btn btn-sm btn-outline-success rounded-pill px-3">Explore All Listings</a>
        </div>

        <div class="row g-4">
          <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach(product => { %>
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                  <div class="position-relative">
                    <img src="<%= productImg(product) %>" 
                         class="card-img-top crop-card-img" 
                         alt="<%= product.product_name %>"
                         style="height: 190px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='/images/crop-placeholder.svg';">
                    <span class="badge bg-success position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill">
                      <i class="fa-solid fa-circle-check me-1"></i> Available
                    </span>
                    <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-3 px-2 py-1 rounded-pill text-white small">
                      <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= product.p_location || (product.district ? (product.district + ', MH') : 'Maharashtra') %>
                    </span>
                  </div>
                  <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="badge bg-success-subtle text-success small"><%= product.category_name || 'Agro' %></span>
                      <small class="text-muted">Stock: <strong><%= Number(product.quantity) %> <%= product.unit %></strong></small>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark text-truncate" title="<%= product.product_name %>"><%= product.product_name %></h5>
                    <p class="small text-muted mb-2 text-truncate"><i class="fa-solid fa-user me-1 text-secondary"></i>Farmer: <%= product.farmer_name || 'Verified Farmer' %></p>
                    <div class="d-flex align-items-baseline gap-1 my-2">
                      <h4 class="fw-bold text-success mb-0">₹<%= Number(product.price).toLocaleString('en-IN') %></h4>
                      <span class="text-muted small">/ <%= product.unit %></span>
                    </div>
                    <div class="mt-auto pt-2 d-flex gap-2">
                      <a href="/products/<%= product.product_id %>" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill">Details</a>
                      <a href="/products/<%= product.product_id %>" class="btn btn-sm btn-success flex-grow-1 rounded-pill text-white">Buy / Order</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-12 py-5 text-center">
              <div class="p-4 bg-light rounded-4 border">
                <i class="fa-solid fa-seedling text-success fs-1 mb-3"></i>
                <h5 class="fw-bold">No crops listed right now</h5>
                <p class="text-muted">Farmers are preparing their harvest listings. Check back soon or register as a farmer to list your crops!</p>
                <a href="/farmer_register" class="btn btn-success rounded-pill px-4">Register as Farmer</a>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Why Choose KisanSetu Section -->
    <section class="py-5">
      <div class="container py-3">
        <div class="text-center mb-5">
          <h6 class="text-success fw-bold text-uppercase mb-2">Market Advantages</h6>
          <h2 class="fw-bold">Why Trade On KisanSetu?</h2>
        </div>

        <div class="row g-4">
          <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm border h-100 text-center">
              <div class="feature-icon-circle mx-auto mb-3 bg-success-subtle text-success">
                <i class="fa-solid fa-hand-holding-dollar fs-3"></i>
              </div>
              <h5 class="fw-bold mb-2">Fair Price Realization</h5>
              <p class="text-muted small mb-0">Farmers directly determine their floor rates and buyers negotiate without paying cuts to intermediary brokers.</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm border h-100 text-center">
              <div class="feature-icon-circle mx-auto mb-3 bg-primary-subtle text-primary">
                <i class="fa-solid fa-map-location-dot fs-3"></i>
              </div>
              <h5 class="fw-bold mb-2">Hyperlocal District Sourcing</h5>
              <p class="text-muted small mb-0">Easily search crops filtered by Maharashtra districts and talukas to cut down transportation distances.</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm border h-100 text-center">
              <div class="feature-icon-circle mx-auto mb-3 bg-warning-subtle text-warning">
                <i class="fa-solid fa-shield-halved fs-3"></i>
              </div>
              <h5 class="fw-bold mb-2">KYC &amp; Verification Security</h5>
              <p class="text-muted small mb-0">Platform admins review farmer identity and crop credentials to maintain a reliable and secure trading environment.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dual Role Registration Callout -->
    <section class="py-5 bg-light-green border-top">
      <div class="container py-3">
        <div class="row g-4 align-items-center">
          <div class="col-lg-6">
            <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm border">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-success-subtle text-success rounded-3 fs-3">
                  <i class="fa-solid fa-tractor"></i>
                </div>
                <div>
                  <h4 class="fw-bold mb-0">Are You A Farmer?</h4>
                  <small class="text-muted">शेतकरी नोंदणी करा आणि थेट विक्री सुरू करा</small>
                </div>
              </div>
              <p class="text-muted mb-4">
                List your harvesting produce, post clear batch photos, set your price, and receive inquiries directly from verified buyers.
              </p>
              <a href="/farmer_register" class="btn btn-success rounded-pill fw-semibold px-4 py-2">
                Register as Farmer <i class="fa-solid fa-arrow-right ms-1"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm border">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3">
                  <i class="fa-solid fa-cart-shopping"></i>
                </div>
                <div>
                  <h4 class="fw-bold mb-0">Are You A Buyer / Trader?</h4>
                  <small class="text-muted">व्यापारी किंवा घाऊक खरेदीदार नोंदणी</small>
                </div>
              </div>
              <p class="text-muted mb-4">
                Find authentic farm lots across districts, send direct crop quotes, and manage your bulk supply chain seamlessly.
              </p>
              <a href="/buyer_register" class="btn btn-primary rounded-pill fw-semibold px-4 py-2">
                Register as Buyer <i class="fa-solid fa-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

<%- include('footer.ejs') %>
