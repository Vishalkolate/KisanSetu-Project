<%- include('../partials/head', { title: (typeof title !== 'undefined' ? title : 'Error') }) %>
<main class="ks-main"><div class="ks-container text-center py-5">
  <div class="ks-card ks-card-pad mx-auto py-5" style="max-width:560px">
    <div class="display-1 fw-bold text-success"><%= typeof code !== 'undefined' ? code : 404 %></div>
    <h2 class="fw-bold"><%= typeof title !== 'undefined' ? title : 'Page not found' %></h2>
    <p class="text-muted"><%= typeof message !== 'undefined' ? message : '' %></p>
    <a href="/" class="btn btn-success"><i class="bi bi-house-door me-1"></i><span data-i18n="err.home">Back to Home</span></a>
  </div>
</div></main>
<%- include('../partials/footer') %>
