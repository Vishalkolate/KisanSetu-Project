<%
  const _fu = typeof currentUser !== 'undefined' ? currentUser : null;
  const _sup = typeof support !== 'undefined' ? support : { phone: '+911800266327', phoneDisplay: '+91 1800-266-3276', email: 'support@kisansetu.in', whatsapp: '911800266327', hours: 'Mon - Sat, 9:00 AM - 7:00 PM IST' };
%>
<footer class="ks-footer">
  <div class="container" style="max-width:1280px">
    <div class="row g-4">
      <div class="col-lg-4">
        <%- include('logo') %>
        <p class="about" data-i18n="footer.about">KisanSetu connects farmers directly with buyers – transparent prices, verified listings and no middlemen.</p>
        <div class="ks-social">
          <a href="https://wa.me/<%= _sup.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
          <a href="mailto:<%= _sup.email %>" aria-label="Email"><i class="bi bi-envelope"></i></a>
          <a href="tel:<%= _sup.phone %>" aria-label="Call"><i class="bi bi-telephone"></i></a>
          <a href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
        </div>
      </div>
      <div class="col-6 col-lg-2">
        <h6 data-i18n="footer.quick">Quick Links</h6>
        <ul>
          <li><a href="/" data-i18n="nav.home">Home</a></li>
          <li><a href="/products" data-i18n="nav.crops">Crops</a></li>
          <li><a href="/about" data-i18n="nav.about">About Us</a></li>
          <li><a href="/contact" data-i18n="nav.contact">Contact Us</a></li>
        </ul>
      </div>
      <div class="col-6 col-lg-2">
        <h6 data-i18n="footer.account">My Account</h6>
        <ul>
          <% if (_fu) { %>
            <li><a href="/<%= _fu.role %>/dashboard" data-i18n="nav.dashboard">Dashboard</a></li>
            <li><a href="/<%= _fu.role %>/profile" data-i18n="nav.profile">My Profile</a></li>
            <li><a href="/<%= _fu.role %>/orders" data-i18n="nav.orders">My Orders</a></li>
            <li><a href="/logout" data-i18n="nav.logout">Logout</a></li>
          <% } else { %>
            <li><a href="/login/farmer" data-i18n="nav.login_farmer">Farmer Login</a></li>
            <li><a href="/login/buyer" data-i18n="nav.login_buyer">Buyer Login</a></li>
            <li><a href="/farmer_register" data-i18n="nav.register_farmer">Register as Farmer</a></li>
            <li><a href="/buyer_register" data-i18n="nav.register_buyer">Register as Buyer</a></li>
          <% } %>
        </ul>
      </div>
      <div class="col-lg-4">
        <h6 data-i18n="footer.help">Help & Support</h6>
        <ul>
          <li><a href="tel:<%= _sup.phone %>"><i class="bi bi-telephone me-2"></i><%= _sup.phoneDisplay %></a></li>
          <li><a href="mailto:<%= _sup.email %>"><i class="bi bi-envelope me-2"></i><%= _sup.email %></a></li>
          <li><a href="https://wa.me/<%= _sup.whatsapp %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-2"></i><span data-i18n="support.whatsapp">WhatsApp chat</span></a></li>
          <li><i class="bi bi-clock me-2"></i><%= _sup.hours %></li>
        </ul>
      </div>
    </div>
    <div class="ks-footer-bottom d-flex flex-wrap justify-content-between gap-2">
      <span>© <%= new Date().getFullYear() %> KisanSetu. <span data-i18n="footer.rights">All rights reserved.</span></span>
      <span><a href="/privacy" data-i18n="footer.privacy">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms" data-i18n="footer.terms">Terms of Use</a></span>
    </div>
  </div>
</footer>
<div class="ks-toasts" id="ks-toasts" aria-live="polite"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/i18n.js"></script>
<script src="/js/ks.js"></script>
</body>
</html>
