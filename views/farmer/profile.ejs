<%- include('../partials/head') %>
<main class="ks-main"><div class="ks-container">
  <div class="ks-page-head"><div><h1 data-i18n="nav.profile">My Profile</h1></div></div>
  <div class="row g-4">
    <div class="col-lg-4"><div class="ks-card ks-card-pad text-center">
      <div class="ks-avatar mx-auto mb-3" style="width:84px;height:84px;font-size:2rem"><%= farmer.full_name.charAt(0).toUpperCase() %></div>
      <h4 class="fw-bold mb-0"><%= farmer.full_name %></h4><div class="text-muted"><%= farmer.farm_name %></div>
      <span class="ks-badge st-<%= farmer.kyc_status %> mt-2"><i class="bi bi-patch-check"></i> KYC: <%= farmer.kyc_status %></span>
      <hr><div class="text-start small d-grid gap-2"><div><i class="bi bi-envelope text-success me-2"></i><%= farmer.email %></div><div><i class="bi bi-telephone text-success me-2"></i><%= farmer.mobile %></div><div><i class="bi bi-geo-alt text-success me-2"></i><%= farmer.district %>, <%= farmer.state %></div></div>
      <hr><div class="row g-2 text-center"><div class="col-6"><div class="fs-4 fw-bold"><%= stats.totalProducts %></div><small class="text-muted" data-i18n="stat.products">Products</small></div><div class="col-6"><div class="fs-4 fw-bold"><%= stats.deliveredOrders %></div><small class="text-muted" data-i18n="stat.delivered">Delivered</small></div></div>
    </div></div>
    <div class="col-lg-8">
      <form method="POST" action="/farmer/profile/update" class="ks-card ks-card-pad mb-4"><h5 class="fw-bold mb-3" data-i18n="prof.details">Details</h5>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" data-i18n="prof.name">Full name</label><input class="form-control" name="fullName" required value="<%= farmer.full_name %>"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.mobile">Mobile</label><input class="form-control" name="mobile" required value="<%= farmer.mobile %>"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.farm">Farm name</label><input class="form-control" name="farmName" value="<%= farmer.farm_name || '' %>"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.email">Email (cannot be changed)</label><input class="form-control" disabled value="<%= farmer.email %>"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="prof.state">State</label><input class="form-control" name="state" value="<%= farmer.state %>"></div>
          <div class="col-md-6"><label class="form-label" data-i18n="f.district">District</label><input class="form-control" name="district" value="<%= farmer.district %>"></div>
          <div class="col-12"><label class="form-label" data-i18n="prof.address">Address</label><input class="form-control" name="address" value="<%= farmer.address || '' %>"></div>
        </div><button class="btn btn-success mt-3" type="submit" data-loading="Saving…"><i class="bi bi-check2-circle me-1"></i><span data-i18n="btn.save">Save changes</span></button></form>
      <form method="POST" action="/farmer/profile/password" class="ks-card ks-card-pad"><h5 class="fw-bold mb-3" data-i18n="prof.password">Change password</h5>
        <div class="row g-3"><div class="col-md-4"><input type="password" class="form-control" name="current_password" placeholder="Current password" data-i18n-ph="prof.cur" required></div><div class="col-md-4"><input type="password" class="form-control" name="new_password" minlength="8" placeholder="New password" data-i18n-ph="prof.new" required></div><div class="col-md-4"><input type="password" class="form-control" name="confirm_password" minlength="8" placeholder="Confirm" data-i18n-ph="prof.confirm" required></div></div>
        <button class="btn btn-outline-success mt-3"><i class="bi bi-key me-1"></i><span data-i18n="btn.update_password">Update password</span></button></form>
    </div>
  </div>
</div></main>
<%- include('../partials/footer') %>
