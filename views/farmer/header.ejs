<!DOCTYPE html>
<html lang="mr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof title !== 'undefined' ? title : 'KisanSetu' %></title>

    <meta name="description" content="KisanSetu - Farmer to Buyer Market">

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Font: Mukta -->
    <link
        href="https://fonts.googleapis.com/css2?family=Mukta:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/farmer/style.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Shared Header -->
    <header class="main-header sticky-top bg-white shadow-sm border-bottom">

        <nav class="navbar navbar-expand-xl py-2">
            <div class="container-fluid px-lg-4">

                <!-- Brand -->
                <a
                    class="navbar-brand d-flex align-items-center text-dark text-decoration-none"
                    href="/farmer/dashboard">

                    <div class="brand-icon me-2 text-success fs-3">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <div class="lh-1">
                        <span class="brand-title fw-bold fs-4">
                            Kisan<span class="text-success">Setu</span>
                        </span>

                        <span
                            class="d-block brand-subtitle text-muted mt-1"
                            style="font-size:0.65rem;letter-spacing:1px;"
                            data-translate="FARMER TO BUYER MARKET">
                            FARMER TO BUYER MARKET
                        </span>
                    </div>
                </a>

                <!-- Mobile Menu Button -->
                <button
                    class="navbar-toggler border-0 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#farmerNavbar"
                    aria-controls="farmerNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation"
                    data-translate-title="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="farmerNavbar">

                    <!-- Navigation Links -->
                    <ul class="navbar-nav mx-auto mb-2 mb-xl-0 gap-xl-1 align-items-xl-center">

                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a
                                class="nav-link text-dark fw-semibold px-3"
                                href="/farmer/dashboard">

                                <i class="bi bi-speedometer2 text-success me-1"></i>

                                <span data-translate="Dashboard">Dashboard</span>
                            </a>
                        </li>

                        <!-- My Produce -->
                        <li class="nav-item dropdown">
                            <a
                                class="nav-link text-dark fw-semibold px-3 dropdown-toggle"
                                href="#"
                                id="productsDropdown"
                                role="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                                <i class="bi bi-box-seam text-success me-1"></i>

                                <span data-translate="My Produce">My Produce</span>
                            </a>

                            <ul
                                class="dropdown-menu shadow-sm border-0"
                                aria-labelledby="productsDropdown">

                                <li>
                                    <a class="dropdown-item py-2" href="/farmer/add_product">
                                        <i class="bi bi-plus-circle me-2 text-success"></i>
                                        <span data-translate="Add New Product">Add New Product</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" href="/farmer/products">
                                        <i class="bi bi-list-ul me-2 text-success"></i>
                                        <span data-translate="Manage Products">Manage Products</span>
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <!-- Enquiries -->
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" href="/farmer/enquiry">
                                <i class="bi bi-envelope text-success me-1"></i>
                                <span data-translate="Enquiries">Enquiries</span>
                            </a>
                        </li>

                        <!-- Orders -->
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" href="/farmer/orders">
                                <i class="bi bi-cart-check text-success me-1"></i>
                                <span data-translate="Orders">Orders</span>
                            </a>
                        </li>

                        <!-- Reports -->
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" href="/farmer/sales_report">
                                <i class="bi bi-bar-chart text-success me-1"></i>
                                <span data-translate="Reports">Reports</span>
                            </a>
                        </li>

                    </ul>

                    <!-- Right Side Controls -->
                    <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-3 mt-3 mt-xl-0">

                        <!-- Language Dropdown -->
                        <div class="dropdown">
                            <button
                                class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-2"
                                type="button"
                                id="languageDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                                <i class="fa-solid fa-globe text-success"></i>
                                <span id="current-lang" class="fw-medium">मराठी</span>
                            </button>

                            <ul
                                class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                                aria-labelledby="languageDropdown">

                                <li>
                                    <a
                                        class="dropdown-item lang-option d-flex justify-content-between align-items-center py-2"
                                        href="#"
                                        data-lang="mr"
                                        aria-pressed="true">

                                        <span>मराठी (Marathi)</span>
                                        <i class="fa-solid fa-check small text-success check-icon"></i>
                                    </a>
                                </li>

                                <li>
                                    <a
                                        class="dropdown-item lang-option d-flex justify-content-between align-items-center py-2"
                                        href="#"
                                        data-lang="en"
                                        aria-pressed="false">

                                        <span>English</span>
                                        <i class="fa-solid fa-check small text-success check-icon d-none"></i>
                                    </a>
                                </li>

                            </ul>
                        </div>

                        <!-- Notifications -->
                        <a
                            href="/farmer/notifications"
                            class="text-dark position-relative"
                            title="Notifications"
                            aria-label="Notifications"
                            data-translate-title="Notifications">

                            <i class="bi bi-bell-fill fs-5"></i>

                            <span
                                class="position-absolute top-0 start-100 translate-middle p-1 bg-warning border border-light rounded-circle">

                                <span
                                    class="visually-hidden"
                                    data-translate="New alerts">
                                    New alerts
                                </span>
                            </span>
                        </a>

                        <!-- User Profile -->
                        <div class="dropdown">
                            <button
                                class="btn btn-light border-0 dropdown-toggle d-flex align-items-center rounded-pill px-3 py-2 shadow-sm"
                                type="button"
                                id="userDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                                <i class="bi bi-person-circle fs-5 text-success me-2"></i>
                                <span class="fw-semibold">Ramesh</span>
                            </button>

                            <ul
                                class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2"
                                aria-labelledby="userDropdown">

                                <!-- My Profile -->
                                <li>
                                    <a class="dropdown-item py-2" href="/farmer/profile">
                                        <i class="bi bi-person me-2 text-secondary"></i>
                                        <span data-translate="My Profile">My Profile</span>
                                    </a>
                                </li>

                                <!-- KYC Documents -->
                                <li>
                                    <a class="dropdown-item py-2" href="/farmer/kyc_docs">
                                        <i class="bi bi-file-earmark-check me-2 text-secondary"></i>
                                        <span data-translate="KYC Documents">KYC Documents</span>
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <!-- Logout -->
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="/farmer/logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        <span data-translate="Logout">Logout</span>
                                    </a>
                                </li>

                            </ul>
                        </div>

                    </div>
                </div>
            </div>
        </nav>
    </header>