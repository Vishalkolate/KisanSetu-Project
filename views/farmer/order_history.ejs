<%- include('../partials/head') %>
<main class="ks-main"><div class="ks-container">
  <div class="ks-page-head"><div><h1 data-i18n="nav.history">Order History</h1><p data-i18n="hist.sub">Delivered, cancelled and rejected orders.</p></div><a href="/farmer/orders" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i><span data-i18n="orders.received">Received Orders</span></a></div>
  <div class="ks-card ks-filter"><div class="row g-3"><div class="col-md-5"><input id="q" class="form-control" placeholder="Search…" data-i18n-ph="f.search"></div><div class="col-md-3"><select id="sel" class="form-select"><option value="all" data-i18n="tab.all">All</option><option value="delivered" data-i18n="status.delivered">Delivered</option><option value="cancelled" data-i18n="status.cancelled">Cancelled</option><option value="rejected" data-i18n="status.rejected">Rejected</option></select></div></div></div>
  <div class="ks-card"><div class="table-responsive"><table class="ks-table"><thead><tr><th data-i18n="col.order">Order</th><th data-i18n="col.buyer">Buyer</th><th data-i18n="col.product">Crop</th><th data-i18n="col.amount">Amount</th><th data-i18n="col.date">Date</th><th data-i18n="col.status">Status</th><th></th></tr></thead><tbody>
    <% orders.forEach(o => { %><tr class="h-row" data-status="<%= o.status %>" data-search="#KS-<%= o.order_id %> <%= o.buyer_name %> <%= o.product_name %>"><td><b>#KS-<%= o.order_id %></b></td><td><%= o.buyer_name %></td><td><%= o.product_name %> <span class="text-muted small">· <%= num(o.quantity) %> <%= o.unit %></span></td><td><b><%= inr(o.total_amount) %></b></td><td><%= fdate(o.delivered_at || o.updated_at || o.created_at) %></td><td><%- statusBadge(o.status) %></td><td><a class="btn btn-sm btn-outline-success" href="/farmer/orders/<%= o.order_id %>/invoice"><i class="bi bi-receipt"></i></a></td></tr><% }) %>
  </tbody></table></div><div id="empty" class="ks-empty <%= orders.length ? 'd-none' : '' %>"><i class="bi bi-clock-history"></i><span data-i18n="empty.history">No past orders</span></div></div>
</div></main>
<script>KS.filterList({ rows: '.h-row', search: '#q', select: '#sel', empty: '#empty' });</script>
<%- include('../partials/footer') %>
